@model ErrorViewModel
@{
    ViewData["Title"] = "पृष्ठ भेटिएन";
    Layout = "_Layout";
}
@{
    Context.Response.StatusCode = 404;
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
            <!-- 404 Illustration -->
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center"
                     style="width:160px;height:160px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#c9956a)">
                    <div class="text-white" style="font-size:4rem;font-weight:800;line-height:1">
                        ४०४
                    </div>
                </div>
            </div>

            <!-- Message -->
            <h2 class="fw-bold mb-3" style="color:var(--primary-dark)">
                पृष्ठ भेटिएन
            </h2>
            <p class="text-muted mb-2" style="max-width:500px;margin:0 auto;font-size:1.05rem">
                तपाईंले खोज्नुभएको पृष्ठ फेला परेन।
            </p>
            <p class="text-muted small mb-4" style="max-width:420px;margin:0 auto">
                यो पृष्ठ हटाइएको, सारिएको, वा कहिल्यै अवस्थित नभएको हुन सक्छ।
                URL सही छ कि छैन जाँच्नुहोस् वा तलका लिङ्कहरू प्रयोग गर्नुहोस्।
            </p>

            <!-- Search Suggestion -->
            <div class="row justify-content-center mb-4">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text" style="background:var(--primary);color:white;border-color:var(--primary)">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="notFoundSearch" class="form-control"
                               placeholder="तालिका, शीर्षक वा नम्बरले खोज्नुहोस्..."
                               style="border-color:#ccc;font-size:0.95rem;padding:10px 14px" />
                        <button class="btn btn-outline-primary" onclick="searchFromNotFound()">
                            खोज्नुहोस्
                        </button>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex justify-content-center gap-3 flex-wrap mb-5">
                <a href="/" class="btn btn-primary" style="border-radius:8px;padding:10px 24px">
                    <i class="bi bi-house-door me-2"></i>गृहपृष्ठ
                </a>
                <button onclick="history.back()" class="btn btn-outline-secondary" style="border-radius:8px;padding:10px 24px">
                    <i class="bi bi-arrow-left me-2"></i>पछाडि जानुहोस्
                </button>
            </div>

            <!-- Helpful Links -->
            <div class="card mx-auto" style="max-width:500px;border-radius:var(--radius);border:1px solid #e0e0e0">
                <div class="card-header text-start" style="background:rgba(45,106,79,0.05);border-bottom:1px solid #e9ecef">
                    <small class="fw-bold" style="color:var(--primary)">
                        <i class="bi bi-compass me-2"></i>सहयोगी पृष्ठहरू
                    </small>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <a href="/Household" class="list-group-item list-group-item-action d-flex align-items-center gap-2 small">
                            <i class="bi bi-people" style="color:var(--primary);width:20px"></i>
                            घरपरिवार तथ्याङ्क (६५ तालिका)
                            <i class="bi bi-chevron-right ms-auto text-muted"></i>
                        </a>
                        <a href="/Institution" class="list-group-item list-group-item-action d-flex align-items-center gap-2 small">
                            <i class="bi bi-bank" style="color:var(--primary);width:20px"></i>
                            संस्थागत तथ्याङ्क (४३ तालिका)
                            <i class="bi bi-chevron-right ms-auto text-muted"></i>
                        </a>
                        <a href="/Ward" class="list-group-item list-group-item-action d-flex align-items-center gap-2 small">
                            <i class="bi bi-geo-alt" style="color:var(--primary);width:20px"></i>
                            वडा प्रोफाइल र तुलना
                            <i class="bi bi-chevron-right ms-auto text-muted"></i>
                        </a>
                        <a href="/Map" class="list-group-item list-group-item-action d-flex align-items-center gap-2 small">
                            <i class="bi bi-map" style="color:var(--primary);width:20px"></i>
                            अन्तरक्रियात्मक नक्सा
                            <i class="bi bi-chevron-right ms-auto text-muted"></i>
                        </a>
                        <a href="/Home/About" class="list-group-item list-group-item-action d-flex align-items-center gap-2 small">
                            <i class="bi bi-info-circle" style="color:var(--primary);width:20px"></i>
                            नगरपालिका परिचय
                            <i class="bi bi-chevron-right ms-auto text-muted"></i>
                        </a>
                    </div>
                </div>
            </div>

            @if (Model.ShowRequestId)
            {
                <div class="mt-3">
                    <small class="text-muted">
                        <i class="bi bi-tag me-1"></i>अनुरोध: <code>@Model.RequestId</code>
                    </small>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function searchFromNotFound() {
            var q = document.getElementById('notFoundSearch').value.trim();
            if (q) {
                window.location = '/Search?q=' + encodeURIComponent(q);
            }
        }
        document.getElementById('notFoundSearch').addEventListener('keydown', function (e) {
            if (e.key === 'Enter') searchFromNotFound();
        });
    </script>
}
