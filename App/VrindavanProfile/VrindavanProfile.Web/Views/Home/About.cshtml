@{
    ViewData["Title"] = "नगरपालिका परिचय";
}

<!-- Hero -->
<section class="py-5" style="background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 50%, var(--secondary) 100%); color: white;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-6 fw-bold mb-2">वृन्दावन नगरपालिका</h1>
                <p class="lead mb-2 opacity-90">नगरपालिका परिचय र संस्थागत जानकारी</p>
                <p class="opacity-75">रुपन्देही जिल्ला, लुम्बिनी प्रदेश, नेपाल</p>
            </div>
            <div class="col-lg-4 text-end d-none d-lg-block">
                <i class="bi bi-building" style="font-size: 5rem; opacity: 0.2;"></i>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <!-- Quick Facts -->
    <div class="row g-4 mb-5">
        <div class="col-md-3 col-6">
            <div class="card text-center p-3 h-100" style="border-radius:var(--radius);border-top:3px solid var(--primary)">
                <i class="bi bi-geo-alt mb-2" style="font-size:2rem;color:var(--primary)"></i>
                <h6 class="fw-bold" style="color:var(--primary)">स्थान</h6>
                <small class="text-muted">रुपन्देही जिल्ला<br/>लुम्बिनी प्रदेश</small>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center p-3 h-100" style="border-radius:var(--radius);border-top:3px solid var(--accent)">
                <i class="bi bi-map mb-2" style="font-size:2rem;color:var(--accent)"></i>
                <h6 class="fw-bold" style="color:var(--primary)">क्षेत्रफल</h6>
                <small class="text-muted">नगरपालिका<br/>विस्तृत क्षेत्र</small>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center p-3 h-100" style="border-radius:var(--radius);border-top:3px solid var(--success)">
                <i class="bi bi-people mb-2" style="font-size:2rem;color:var(--success)"></i>
                <h6 class="fw-bold" style="color:var(--primary)">जनसंख्या</h6>
                <small class="text-muted">सर्वेक्षण तथ्याङ्क<br/>आधारित</small>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center p-3 h-100" style="border-radius:var(--radius);border-top:3px solid var(--info)">
                <i class="bi bi-grid-3x3 mb-2" style="font-size:2rem;color:var(--info)"></i>
                <h6 class="fw-bold" style="color:var(--primary)">वडा संख्या</h6>
                <small class="text-muted">प्रशासनिक<br/>वडाहरू</small>
            </div>
        </div>
    </div>

    <!-- About Content -->
    <div class="row g-5">
        <!-- Main Content -->
        <div class="col-lg-8">
            <h3 class="section-title">नगरपालिकाको परिचय</h3>
            <div class="mb-4">
                <p>
                    वृन्दावन नगरपालिका नेपालको लुम्बिनी प्रदेश, रुपन्देही जिल्लामा अवस्थित एक स्थानीय तह हो।
                    यो नगरपालिका लुम्बिनी — भगवान बुद्धको जन्मस्थल — को नजिकै अवस्थित छ, जसले गर्दा
                    यस क्षेत्रको धार्मिक, सांस्कृतिक र ऐतिहासिक महत्त्व अत्यन्त विशिष्ट छ।
                </p>
                <p>
                    नगरपालिकाले विकास योजना निर्माण र सेवा वितरणलाई तथ्याङ्कमा आधारित बनाउन
                    घरपरिवार तथा संस्थागत सर्वेक्षण सम्पन्न गरेको छ। यो डिजिटल प्रोफाइल प्रणालीले
                    उक्त सर्वेक्षणको तथ्याङ्कलाई दृश्यात्मक रूपमा प्रस्तुत गर्दछ।
                </p>
            </div>

            <h3 class="section-title">डिजिटल प्रोफाइल प्रणाली</h3>
            <div class="mb-4">
                <p>
                    यो प्रणालीले वृन्दावन नगरपालिकाको घरपरिवार सर्वेक्षण (६५ तालिका) र
                    संस्थागत सर्वेक्षण (४३ तालिका) को तथ्याङ्कलाई डिजिटल रूपमा प्रस्तुत गर्दछ।
                    प्रयोगकर्ताहरू निम्न सुविधाहरू प्रयोग गर्न सक्छन्:
                </p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <i class="bi bi-check-circle-fill text-success mt-1"></i>
                            <small><strong>ड्यासबोर्ड</strong> — समग्र तथ्याङ्कको चार्ट र ग्राफ</small>
                        </div>
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <i class="bi bi-check-circle-fill text-success mt-1"></i>
                            <small><strong>वडा प्रोफाइल</strong> — प्रत्येक वडाको विस्तृत तथ्याङ्क</small>
                        </div>
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <i class="bi bi-check-circle-fill text-success mt-1"></i>
                            <small><strong>घरपरिवार तथ्याङ्क</strong> — ६५ वटा तालिका</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <i class="bi bi-check-circle-fill text-success mt-1"></i>
                            <small><strong>संस्थागत तथ्याङ्क</strong> — ४३ वटा तालिका</small>
                        </div>
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <i class="bi bi-check-circle-fill text-success mt-1"></i>
                            <small><strong>अन्तरक्रियात्मक नक्सा</strong> — GPS आधारित नक्सा</small>
                        </div>
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <i class="bi bi-check-circle-fill text-success mt-1"></i>
                            <small><strong>PDF/CSV निर्यात</strong> — तालिका निर्यात सुविधा</small>
                        </div>
                    </div>
                </div>
            </div>

            <h3 class="section-title">सर्वेक्षण क्षेत्रहरू</h3>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card p-3" style="border-radius:var(--radius-sm);border:1px solid #e0e0e0;border-left:3px solid var(--primary)">
                        <h6 class="fw-bold" style="color:var(--primary)"><i class="bi bi-people me-2"></i>घरपरिवार सर्वेक्षण</h6>
                        <small class="text-muted">
                            जनसंख्या, लिङ्ग, उमेर, जातजाति, धर्म, शिक्षा, व्यवसाय, आयआर्जन,
                            घरदहलो, खानेपानी, सरसफाइ, स्वास्थ्य, कृषि, पशुपालन, ऋण, विपद्द, सम्पत्ति लगायत
                        </small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card p-3" style="border-radius:var(--radius-sm);border:1px solid #e0e0e0;border-left:3px solid var(--accent)">
                        <h6 class="fw-bold" style="color:var(--primary)"><i class="bi bi-bank me-2"></i>संस्थागत सर्वेक्षण</h6>
                        <small class="text-muted">
                            शैक्षिक संस्था, स्वास्थ्य संस्था, वित्तीय संस्था, होटेल/रिसोर्ट, पुल,
                            उद्योग, एनजीओ/क्लब, भू-उपयोग, प्राकृतिक स्रोत, सांस्कृतिक सम्पदा लगायत
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="card mb-4" style="border-radius:var(--radius);border:1px solid #e0e0e0">
                <div class="card-header" style="background:var(--primary);color:#fff;border-radius:var(--radius) var(--radius) 0 0">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-telephone me-2"></i>सम्पर्क जानकारी</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold">ठेगाना</label>
                        <p class="mb-0 small">वृन्दावन नगरपालिका<br/>रुपन्देही जिल्ला, लुम्बिनी प्रदेश<br/>नेपाल</p>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold">फोन</label>
                        <p class="mb-0 small"><i class="bi bi-telephone me-1"></i>नगरपालिका कार्यालय</p>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold">इमेल</label>
                        <p class="mb-0 small"><i class="bi bi-envelope me-1"></i>नगरपालिका इमेल</p>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold">वेबसाइट</label>
                        <p class="mb-0 small"><i class="bi bi-globe me-1"></i>नगरपालिका वेबसाइट</p>
                    </div>
                </div>
            </div>

            <div class="card mb-4" style="border-radius:var(--radius);border:1px solid #e0e0e0">
                <div class="card-header" style="background:var(--accent);color:var(--text-dark);border-radius:var(--radius) var(--radius) 0 0">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-link-45deg me-2"></i>छिटो लिङ्क</h6>
                </div>
                <div class="list-group list-group-flush">
                    <a href="/" class="list-group-item list-group-item-action small">
                        <i class="bi bi-speedometer me-2"></i>ड्यासबोर्ड
                    </a>
                    <a href="/Household" class="list-group-item list-group-item-action small">
                        <i class="bi bi-people me-2"></i>घरपरिवार तथ्याङ्क
                    </a>
                    <a href="/Institution" class="list-group-item list-group-item-action small">
                        <i class="bi bi-bank me-2"></i>संस्थागत तथ्याङ्क
                    </a>
                    <a href="/Ward/Compare" class="list-group-item list-group-item-action small">
                        <i class="bi bi-arrow-left-right me-2"></i>वडा तुलना
                    </a>
                    <a href="/Map" class="list-group-item list-group-item-action small">
                        <i class="bi bi-map me-2"></i>नक्सा
                    </a>
                </div>
            </div>

            <div class="card" style="border-radius:var(--radius);border:1px solid #e0e0e0">
                <div class="card-body text-center p-4">
                    <i class="bi bi-shield-check" style="font-size:3rem;color:var(--primary);opacity:0.3"></i>
                    <h6 class="fw-bold mt-2" style="color:var(--primary)">तथ्याङ्क सुरक्षा</h6>
                    <small class="text-muted">
                        सर्वेक्षण तथ्याङ्क वृन्दावन नगरपालिकाको स्वामित्वमा छ।
                        सम्पूर्ण तथ्याङ्क नगरपालिकाको अधिकारमा सुरक्षित राखिएको छ।
                    </small>
                </div>
            </div>
        </div>
    </div>
</section>
