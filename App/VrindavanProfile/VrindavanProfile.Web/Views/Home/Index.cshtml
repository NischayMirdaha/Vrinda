@model VrindavanProfile.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["MetaDescription"] = "वृन्दावन नगरपालिकाको समग्र तथ्याङ्क — घरपरिवार संख्या, जनसंख्या, लिङ्ग वितरण, शिक्षा, स्वास्थ्य, आर्थिक अवस्था र पूर्वाधारको चार्ट तथा तथ्याङ्क";
    var lang = Model.CurrentLang;
    var isEn = lang == "en";
    var grouped = Model.Charts.GroupBy(c => c.GetCategory(lang)).ToList();
}

<style>
    .intro-content p {
        text-align: justify;
        line-height: 1.9;
        color: #333;
        font-size: 1.05rem;
    }

    .intro-content h5 {
        color: #002147;
        border-left: 3px solid #DC143C;
        padding-left: 12px;
    }

    @@media (max-width: 768px) {
    .intro-content {
        font-size: 0.95rem !important;
        line-height: 1.7 !important;
    }
    }
    
    /* FIX: Prevents print/pdf background sections from staying visible on screen */
    @@media screen {
        .print-header-section, 
        .pdf-header-section, 
        [id^="print-header"], 
        [class*="print-only"],
        .printing-overlay {
            display: none !important;
        }
    }
</style>

<!-- Hero Section -->
<section class="hero-section py-5" style="background: linear-gradient(135deg, #002147 0%, #003B6F 40%, #DC143C 100%); color: white;" aria-label="नगरपालिका परिचय">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-5 fw-bold mb-3">
                    <span data-i18n="hero.title">वृन्दावन नगरपालिका</span>
                    <span style="display:inline-block;width:40px;height:4px;background:#DC143C;border-radius:2px;vertical-align:middle;margin-left:8px" aria-hidden="true"></span>
                </h1>
                <p class="lead mb-2 opacity-90" data-i18n="hero.subtitle">डिजिटल प्रोफाइल प्रणाली</p>
                <p class="opacity-75">
                    <span data-i18n="hero.location_line">रौतहट जिल्ला, मधेश प्रदेश, नेपाल —</span>
                    <span data-i18n="hero.description_line">तथ्याङ्कमा आधारित विकास योजना निर्माणका लागि घरपरिवार तथा संस्थागत सर्वेक्षणको डिजिटल प्रस्तुति</span>
                </p>
            </div>
            <div class="col-lg-4 text-end d-none d-lg-block">
                <div class="export-btn-group mb-3 justify-content-end">
                    <button class="btn btn-sm" style="background:rgba(220,20,60,0.25);color:#fff;border:1px solid rgba(220,20,60,0.4)" onclick="exportDashboardPDF()">
                        <i class="bi bi-file-earmark-pdf"></i> PDF
                    </button>
                    <button class="btn btn-sm" style="background:rgba(255,255,255,0.15);color:#fff;border:1px solid rgba(255,255,255,0.3)" onclick="printPage()">
                        <i class="bi bi-printer"></i> <span data-i18n="export.print">प्रिन्ट</span>
                    </button>
                </div>
                <i class="bi bi-bar-chart-line" style="font-size: 5rem; opacity: 0.2;"></i>
            </div>
        </div>
    </div>
</section>

<!-- Stat Counter Cards -->
@if (Model.StatCounters.Any())
{
    <section class="container mt-n4" style="position: relative; z-index: 10;" aria-label="@(isEn ? "Key Statistics Summary" : "मुख्य तथ्याङ्क सारांश")">
        <div class="row g-3">
            @foreach (var stat in Model.StatCounters)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="stat-card card h-100 p-3 overflow-hidden"
                         style="border-left-color: @stat.AccentColor; --stat-accent: @stat.AccentColor;"
                         role="status"
                         aria-label="@stat.GetLabel(lang): @stat.Value.ToString("#,##0")">
                        <div class="stat-card-bg-circle" style="background: @stat.AccentColor" aria-hidden="true"></div>
                        <div class="d-flex justify-content-between align-items-start position-relative">
                            <div class="flex-grow-1">
                                <div class="stat-value counter-value" data-target="@stat.Value" aria-hidden="true">0</div>
                                <div class="stat-label">@stat.GetLabel(lang)</div>
                                <div class="stat-badge" aria-hidden="true">
                                    <i class="bi bi-activity"></i> <span data-i18n="stats.data_tag">तथ्याङ्क</span>
                                </div>
                            </div>
                            <div class="stat-icon-wrapper" style="--glow-color: @stat.AccentColor" aria-hidden="true">
                                <div class="stat-icon-bg" style="background: @stat.AccentColor"></div>
                                <i class="bi @stat.Icon stat-icon-inner"></i>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- Municipality Introduction Paragraph -->
<section class="container mt-5 mb-5">
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <h3 class="fw-bold mb-4" style="color: #002147; border-left: 5px solid #DC143C; padding-left: 15px;">
                बृन्दावन नगरपालिकाको संक्षिप्त परिचय
            </h3>

            <div class="intro-content" style="text-align: justify; line-height: 1.9; color: #333; font-size: 1.05rem;">
                
                <p class="mb-3">
                    संवैधानिक राजतन्त्र र एकात्मक शासन व्यवस्थाको अन्त्य भई गणतन्त्रात्मक शासन व्यवस्था स्थापना भएपछि नेपालमा संघीय शासन प्रणालीको कार्यान्वयनसँगै राज्य संरचनामा आमूल परिवर्तन आएको छ। वि.सं. २०७२ सालमा जारी नेपालको संविधानले संघ, प्रदेश र स्थानीय तह गरी तीन तहको शासन व्यवस्था सुनिश्चित गरेको छ। सोही संविधानले स्थानीय तहलाई सरकारको हैसियत प्रदान गर्दै स्थानीय स्वशासनको अधिकार प्रत्यायोजन गरेको छ।
                </p>

                <h5 class="fw-bold mt-4 mb-3" style="color: #002147;">स्थापना र भौगोलिक अवस्थिति</h5>
                <p class="mb-3">
                    पूर्व–पश्चिम महेन्द्र राजमार्गको चन्द्रनिगाहपुरबाट करिब १५ किलोमिटर दक्षिणमा अवस्थित तथा गौर जाने वीरन्द्र राजमार्गसँग आंशिक रूपमा जोडिएको बृन्दावन नगरपालिका हाल ९ वटा वडामा विभाजित रहेको छ। साविकका विश्रामपुर, रमौली बैरिया, हर्दिया, सखुवाधमौरा र गम्हरिया बिर्ता गाउँ विकास समितिहरू समायोजन भई प्रारम्भमा बृन्दावन गाउँपालिकाको गठन भएको थियो। पछि वि.सं. २०७३ फागुन २७ गते यसलाई बृन्दावन नगरपालिकाको रूपमा स्तरोन्नति गरिएको हो। नगरपालिकाको केन्द्रीय कार्यालय विश्रामपुरमा रहेको छ।
                </p>

                <p class="mb-3">
                    मधेश प्रदेश अन्तर्गत रौतहट जिल्लामा अवस्थित १८ वटा स्थानीय तहमध्ये बृन्दावन नगरपालिका एक महत्वपूर्ण स्थानीय तह हो। रौतहट जिल्लाको उत्तर–पूर्वी क्षेत्रमा अवस्थित यस नगरपालिका २७.०३०° उत्तर अक्षांश र ८५.२८०° पूर्व देशान्तरसम्म फैलिएको छ। समुद्री सतहबाट करिब ८७ मिटरदेखि १४४ मिटर उचाइसम्म रहेको यस नगरपालिकाको कुल क्षेत्रफल ९५.४० वर्ग किलोमिटर रहेको छ। यसको पूर्वमा बागमती नदी तथा सर्लाही जिल्ला, पश्चिममा गुजरा नगरपालिका र कटहरिया नगरपालिका, उत्तरमा चन्द्रपुर नगरपालिका तथा दक्षिणमा गढीमाई नगरपालिका र गरुडा नगरपालिका रहेका छन्।
                </p>

                <h5 class="fw-bold mt-4 mb-3" style="color: #002147;">भू–भाग, अर्थतन्त्र र संस्कृति</h5>
                <p class="mb-3">
                    यहाँको भू–भाग मुख्यतः समथर तथा उर्वर रहेको छ, जसले कृषि उत्पादनका लागि अनुकूल वातावरण प्रदान गरेको छ। कृषि यहाँको प्रमुख आर्थिक आधार हो र अधिकांश नागरिक प्रत्यक्ष वा अप्रत्यक्ष रूपमा कृषिमा निर्भर रहेका छन्। ऐतिहासिक रूपमा यो क्षेत्र प्राचीन मिथिला सभ्यता र संस्कृतिको प्रभाव क्षेत्रमा पर्दछ। यहाँका सामाजिक मूल्य, परम्परा तथा सांस्कृतिक अभ्यासहरूमा मिथिला संस्कृतिको गहिरो प्रभाव देख्न सकिन्छ।
                </p>

                <h5 class="fw-bold mt-4 mb-3" style="color: #002147;">नामकरण र जनसंरचना</h5>
                <p class="mb-3">
                    नगरपालिकाको नाम "वृन्दावन" भगवान् श्रीकृष्णसँग सम्बन्धित धार्मिक आस्था र सांस्कृतिक विश्वासबाट प्रेरित भएको मानिन्छ। वडा नं. १ मा बसोबास गर्ने अधिकांश बासिन्दाहरू श्रीकृष्ण प्रणामी धर्ममा आस्था राख्ने गर्दछन्। उक्त बस्तीलाई केही समुदायले "वृन्दावन" भनी सम्बोधन गर्ने परम्परा रहेको तथा त्यहाँ श्रीकृष्णको मन्दिरसमेत अवस्थित भएकाले नगरपालिकाको नाम "वृन्दावन नगरपालिका" राखिएको मानिन्छ। यस क्षेत्रमा विभिन्न जातजाति, भाषा र धर्मावलम्बी समुदायहरूको सहअस्तित्व रहेको छ। यादव, कुर्मी, साह, तेली, दलित, मुस्लिम, थारू लगायतका समुदाय यहाँका प्रमुख बासिन्दा हुन्। नेपाली, मैथिली, भोजपुरी, थारू तथा हिन्दी भाषाहरू यहाँ व्यापक रूपमा बोलिने भाषाहरू हुन्।
                </p>

                <h5 class="fw-bold mt-4 mb-3" style="color: #002147;">पर्व, परम्परा र सामाजिक सद्भाव</h5>
                <p class="mb-3">
                    छठ पर्व यस क्षेत्रको प्रमुख तथा सर्वाधिक महत्वपूर्ण सांस्कृतिक पर्वका रूपमा मनाइन्छ। त्यसैगरी होली, दीपावली, रामनवमी, कृष्ण जन्माष्टमी, तीज तथा जितिया पर्वहरू पनि विशेष उत्साहका साथ मनाइन्छन्। मुस्लिम समुदायले ईद, बकर–ईद तथा मुहर्रम पर्वलाई धार्मिक श्रद्धा र आस्थाका साथ मनाउने गर्दछ। लोकगीत, भजन, कीर्तन, झिझिया तथा सामा–चकेवा जस्ता सांस्कृतिक परम्पराहरू आज पनि यहाँ जीवित छन्।
                </p>

                <p class="mb-0">
                    सामाजिक सद्भाव, धार्मिक सहिष्णुता तथा सामुदायिक सहकार्य यहाँका प्रमुख विशेषताहरू हुन्। स्थानीय तहको स्थापना पश्चात् शिक्षा, स्वास्थ्य, कृषि, खानेपानी, सरसफाइ तथा भौतिक पूर्वाधार विकासका क्षेत्रमा उल्लेखनीय प्रयासहरू भएका छन्। नगरपालिकाले सुशासन, प्रभावकारी सेवा प्रवाह तथा नागरिक सहभागितामूलक विकासलाई प्राथमिकता दिँदै आएको छ। राजनीतिक, ऐतिहासिक तथा सांस्कृतिक विविधताले वृन्दावन नगरपालिकालाई रौतहट जिल्लाको एक महत्वपूर्ण र सम्भावनायुक्त स्थानीय तहका रूपमा स्थापित गरेको छ।
                </p>

            </div>
        </div>
    </div>
</section>

<!-- Chart Sections -->
@if (grouped.Any())
{
    <div class="container mt-5">
        <h2 class="section-title mb-3" data-i18n="charts.profile_summary">नगरपालिकाको तथ्याङ्क चार्टहरू</h2>
        <nav>
            <ul class="nav nav-pills flex-wrap gap-1 mb-0" id="homeChartTabs" role="tablist">
                @{
                    bool isFirst = true;
                    int tabIndex = 0;
                }
                @foreach (var group in grouped)
                {
                    string tabId = "tab-" + tabIndex;
                    string paneId = "pane-" + tabIndex;
                    string isActive = isFirst ? "active" : "";
                    string selectedc = isFirst ? "true" : "false";
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @isActive fw-semibold"
                                id="@tabId"
                                data-bs-toggle="pill"
                                data-bs-target="#@paneId"
                                type="button"
                                role="tab"
                                aria-controls="@paneId"
                                aria-selected="@selectedc">
                            @group.Key
                            <span class="badge bg-light text-dark ms-1" style="font-size:10px;">@group.Count()</span>
                        </button>
                    </li>
                    isFirst = false;
                    tabIndex++;
                }
            </ul>
        </nav>
        <hr class="mt-2 mb-0" />
    </div>

    <!-- Tab Pane Content -->
    <div class="container mt-4">
        <div class="tab-content" id="homeChartTabsContent">
            @{
                isFirst = true;
                tabIndex = 0;
            }
            @foreach (var group in grouped)
            {
                string paneId = "pane-" + tabIndex;
                string isActive = isFirst ? "show active" : "";

                <div class="tab-pane fade @isActive"
                     id="@paneId"
                     role="tabpanel"
                     aria-labelledby="tab-@tabIndex">
                    <div class="row g-4">
                        @foreach (var chart in group.OrderBy(c => c.SortOrder))
                        {
                            <div class="col-md-6 @(chart.ChartType == "agePyramid" || chart.ChartType == "stackedBar" ? "col-lg-8" : "col-lg-4")">
                                <div class="chart-card card h-100" data-chart-type="@chart.ChartType">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0">@chart.GetTitle(lang)</h6>
                                    </div>
                                    <div class="card-body">
                                        @if (chart.Items.Any() || (chart.Datasets != null && chart.Datasets.Any()))
                                        {
                                            <div class="chart-wrapper" id="chartWrap_@chart.Id">
                                                <div class="chart-skeleton" id="skeleton_@chart.Id">
                                                    <div class="skeleton-title"></div>
                                                    <div class="skeleton-bars">
                                                        <div class="skeleton-bar" style="height:60%"></div>
                                                        <div class="skeleton-bar" style="height:85%"></div>
                                                        <div class="skeleton-bar" style="height:45%"></div>
                                                        <div class="skeleton-bar" style="height:70%"></div>
                                                        <div class="skeleton-bar" style="height:55%"></div>
                                                    </div>
                                                    <div class="skeleton-legend">
                                                        <div class="skeleton-dot"></div>
                                                        <div class="skeleton-dot"></div>
                                                        <div class="skeleton-dot"></div>
                                                    </div>
                                                </div>
                                                <canvas id="chart_@chart.Id" height="250" style="display:none"></canvas>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center text-muted py-4">
                                                <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                                                <p class="small mt-2 mb-0" data-i18n="charts.no_data">तथ्याङ्क उपलब्ध छैन</p>
                                            </div>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(chart.DetailLink) && chart.Items.Any())
                                    {
                                        <div class="card-footer bg-transparent border-top-0 text-end pb-3 pe-3">
                                            <a href="@chart.DetailLink" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-table me-1"></i>@chart.GetDetailLinkText(lang)
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                isFirst = false;
                tabIndex++;
            }
        </div>
    </div>
}

<!-- Quick Access Cards -->
<section class="container mt-5 mb-5" aria-label="@(isEn ? "Data Exploration Links" : "तथ्याङ्क अन्वेषण लिङ्कहरू")">
    <h2 class="section-title" data-i18n="charts.exploration_title">तथ्याङ्क अन्वेषण</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <a href="/Ward" class="text-decoration-none">
                <div class="chart-card card h-100 text-center p-4">
                    <i class="bi bi-geo-alt" style="font-size: 3rem; color: var(--primary);"></i>
                    <h5 class="mt-3 fw-bold" style="color: var(--primary);" data-i18n="charts.ward_profile">वडा प्रोफाइल</h5>
                    <p class="text-muted small" data-i18n="charts.ward_desc">प्रत्येक वडाको विस्तृत तथ्याङ्क हेर्नुहोस्</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Household" class="text-decoration-none">
                <div class="chart-card card h-100 text-center p-4">
                    <i class="bi bi-people" style="font-size: 3rem; color: var(--accent);"></i>
                    <h5 class="mt-3 fw-bold" style="color: var(--accent);" data-i18n="charts.household_data">घरपरिवार तथ्याङ्क</h5>
                    <p class="text-muted small" data-i18n="charts.household_desc">६५ वटा घरपरिवार तालिकाहरू</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Institution" class="text-decoration-none">
                <div class="chart-card card h-100 text-center p-4">
                    <i class="bi bi-bank" style="font-size: 3rem; color: var(--primary);"></i>
                    <h5 class="mt-3 fw-bold" style="color: var(--primary);" data-i18n="charts.institution_data">संस्थागत तथ्याङ्क</h5>
                    <p class="text-muted small" data-i18n="charts.institution_desc">४३ वटा संस्थागत तालिकाहरू</p>
                </div>
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script>
        const currentLang = '@lang';

        const allCharts = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                Model.Charts.Where(c => c.Items.Any() || (c.Datasets != null && c.Datasets.Any())).Select(c => new {
                    id = c.Id,
                    chartType = c.ChartType,
                    Title = c.GetTitle(Model.CurrentLang),
                    items = c.Items.Select(i => new { label = i.Label, value = i.Value, maleCount = i.MaleCount, femaleCount = i.FemaleCount }),
                    datasets = c.Datasets?.Select(ds => new { label = ds.Label, values = ds.Values })
                })
            )
        );

        document.addEventListener('DOMContentLoaded', function () {
            // Show stat cards with staggered animation
            document.querySelectorAll('.stat-card').forEach(function(card, i) {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                setTimeout(function() {
                    card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, i * 100);
            });

            // Render charts with skeleton transition
            setTimeout(function() {
                if (typeof renderAllCharts === 'function') {
                    renderAllCharts(allCharts);
                }

                allCharts.forEach(function(chartData) {
                    var skeleton = document.getElementById('skeleton_' + chartData.id);
                    var canvas = document.getElementById('chart_' + chartData.id);
                    if (skeleton && canvas) {
                        skeleton.style.opacity = '0';
                        setTimeout(function() {
                            skeleton.style.display = 'none';
                            canvas.style.display = 'block';
                            canvas.style.opacity = '0';
                            canvas.style.transition = 'opacity 0.4s ease';
                            requestAnimationFrame(function() {
                                canvas.style.opacity = '1';
                            });
                        }, 300);
                    }
                });

                if (typeof animateCounters === 'function') {
                    animateCounters();
                }
            }, 400);
        });

        // FIX: Remove/Hide white print background after export
        window.addEventListener('afterprint', function() {
            const extraSections = document.querySelectorAll('.print-header-section, .pdf-header-section, .printing-overlay');
            extraSections.forEach(el => {
                el.style.display = 'none';
                // If the export tool injected these as permanent DOM elements, we hide them
                el.classList.add('d-none');
            });
        });
    </script>
    <script src="~/js/table-export.js" asp-append-version="true"></script>
}