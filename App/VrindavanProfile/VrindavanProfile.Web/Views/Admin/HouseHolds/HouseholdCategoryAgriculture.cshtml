            <div class="card-header" style="background:#6A5ACD;color:white" data-bs-toggle="collapse" data-bs-target="#secBanking" style="cursor:pointer">
                <h6 class="mb-0"><i class="bi bi-bank"></i> खण्ड १६: बैंक तथा ऋण</h6>
            </div>
            <div class="card-body collapse show" id="secBanking">
                @* Bank Account *@
                <div class="row mb-3">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">बैंक खाता छ?</label>
                        <select name="HasBankAccount" class="form-select">
                            <option value="">-- चयन गर्नुहोस् --</option>
                            <option value="1" selected="@(Model.HasBankAccount?.ToString() == "1")"> हो </option>
                            <option value="0" selected="@(Model.HasBankAccount?.ToString() == "0")"> होइन </option>
                        </select>
                    </div>
                    <div class="col-md-8 mb-3">
                        <label class="form-label">बैंक खाता सारांश</label>
                        <input type="text" name="BankAccountSummary" class="form-control" value="@Model.BankAccountSummary" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">खाता प्रकार</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="BankAccountBank" value="1" @(Model.BankAccountBank == 1 ? "checked" : "") />
                            <label class="form-check-label">बैंक</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="BankAccountCoop" value="1" @(Model.BankAccountCoop == 1 ? "checked" : "") />
                            <label class="form-check-label">सहकारी</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="BankAccountSavings" value="1" @(Model.BankAccountSavings == 1 ? "checked" : "") />
                            <label class="form-check-label">बचत समूह</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="BankAccountMoneylender" value="1" @(Model.BankAccountMoneylender == 1 ? "checked" : "") />
                            <label class="form-check-label">महाजन</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="BankAccountOther" value="1" @(Model.BankAccountOther == 1 ? "checked" : "") />
                            <label class="form-check-label">अन्य</label>
                        </div>
                    </div>
                </div>
