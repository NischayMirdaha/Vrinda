                        <input type="number" step="0.01" name="HoneyAnnualIncome" class="form-control" value="@Model.HoneyAnnualIncome" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">अनुदान</label>
                        <input type="text" name="BeeSubsidy" class="form-control" value="@Model.BeeSubsidy" />
                    </div>
                </div>
            </div>
        </div>

        @* ===== SECTION: INCOME (आम्दानी) ===== *@
