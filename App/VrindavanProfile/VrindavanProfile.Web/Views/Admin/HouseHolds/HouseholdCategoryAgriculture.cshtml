@model dynamic
@{
    long householdId = ViewBag.HouseholdId;
    string householdInfo = ViewBag.HouseholdInfo ?? "";
}

<div class="container-fluid">
    @* ===== HEADER ===== *@
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin"><i class="bi bi-speedometer2"></i> व्यवस्थापन</a></li>
                    <li class="breadcrumb-item"><a href="/Admin/Households"><i class="bi bi-people"></i> घरपरिवार सूची</a></li>
                    <li class="breadcrumb-item"><a href="/Admin/ManageHouseholdData/@householdId">व्यवस्थापन</a></li>
                    <li class="breadcrumb-item active" aria-current="page"><i class="bi bi-tree"></i> कृषि तथा पशुपालन</li>
                </ol>
            </nav>
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-tree"></i> कृषि तथा पशुपालन — @householdInfo</h5>
                    <small>घरपरिवार ID: @householdId</small>
                </div>
            </div>
        </div>
    </div>

    <form method="post" asp-action="HouseholdCategoryAgriculture">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@householdId" />

        @* ===== SECTION: LAND (भूमि) ===== *@
        <div class="card mb-3">
            <div class="card-header bg-success text-white" data-bs-toggle="collapse" data-bs-target="#secLand" style="cursor:pointer">
                <h6 class="mb-0"><i class="bi bi-geo-alt"></i> खण्ड ८: कृषि भूमि</h6>
            </div>
            <div class="card-body collapse show" id="secLand">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">कृषि योग्य भूमि छ?</label>
                        <select name="HasAgricultureLand" class="form-select">
                            <option value="">-- चयन गर्नुहोस् --</option>
                            <option value="1" selected="@(Model.HasAgricultureLand?.ToString() == "1")"> हो </option>
                            <option value="0" selected="@(Model.HasAgricultureLand?.ToString() == "0")"> होइन </option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">आफ्नो जग्गा (कट्ठा)</label>
                        <input type="number" step="0.01" name="OwnLandKattha" class="form-control" value="@Model.OwnLandKattha" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">अरूको जग्गा (कट्ठा)</label>
                        <input type="number" step="0.01" name="OthersLandKattha" class="form-control" value="@Model.OthersLandKattha" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">अन्य स्वामित्व (कट्ठा)</label>
                        <input type="number" step="0.01" name="OtherOwnershipKattha" class="form-control" value="@Model.OtherOwnershipKattha" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">खेत क्षेत्र (कट्ठा)</label>
                        <input type="number" step="0.01" name="KhetAreaKattha" class="form-control" value="@Model.KhetAreaKattha" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">बारी क्षेत्र (कट्ठा)</label>
                        <input type="number" step="0.01" name="BariAreaKattha" class="form-control" value="@Model.BariAreaKattha" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">पर्ती जग्गा (कट्ठा)</label>
                        <input type="number" step="0.01" name="FallowLandKattha" class="form-control" value="@Model.FallowLandKattha" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">सिंचाई अवस्था</label>
                        <input type="text" name="IrrigationStatus" class="form-control" value="@Model.IrrigationStatus" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">सिंचाई माध्यम सारांश</label>
                        <input type="text" name="IrrigationMediumSummary" class="form-control" value="@Model.IrrigationMediumSummary" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label">सिंचाई स्रोत (जाँच गर्नुहोस्)</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="IrrigationCanal" value="1" @(Model.IrrigationCanal == 1 ? "checked" : "") />
                            <label class="form-check-label">नहर</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="IrrigationTubewell" value="1" @(Model.IrrigationTubewell == 1 ? "checked" : "") />
                            <label class="form-check-label">ट्युबवेल</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="IrrigationElectric" value="1" @(Model.IrrigationElectric == 1 ? "checked" : "") />
                            <label class="form-check-label">इलेक्ट्रिक पम्प</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">खेती गर्ने विधि</label>
                        <input type="text" name="FarmingMethod" class="form-control" value="@Model.FarmingMethod" />
                    </div>
                </div>
            </div>
        </div>

        @* ===== SECTION: CEREALS (अन्नबाली) ===== *@
        <div class="card mb-3">
            <div class="card-header bg-warning text-dark" data-bs-toggle="collapse" data-bs-target="#secCereals" style="cursor:pointer">
                <h6 class="mb-0"><i class="bi bi-bucket"></i> खण्ड ९.१: अन्नबाली</h6>
            </div>
            <div class="card-body collapse show" id="secCereals">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">अन्नबाली खेती गर्नुभएको?</label>
                        <select name="HasCerealCrops" class="form-select">
                            <option value="">-- चयन गर्नुहोस् --</option>
                            <option value="1" selected="@(Model.HasCerealCrops?.ToString() == "1")"> हो </option>
                            <option value="0" selected="@(Model.HasCerealCrops?.ToString() == "0")"> होइन </option>
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">अन्नबाली सारांश</label>
                        <input type="text" name="CerealCropSummary" class="form-control" value="@Model.CerealCropSummary" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">खेती गर्ने अन्नबाली</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="CerealRice" value="1" @(Model.CerealRice == 1 ? "checked" : "") />
                            <label class="form-check-label">धान</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="CerealMaize" value="1" @(Model.CerealMaize == 1 ? "checked" : "") />
                            <label class="form-check-label">मकै</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="CerealWheat" value="1" @(Model.CerealWheat == 1 ? "checked" : "") />
                            <label class="form-check-label">गहुँ</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="CerealBarley" value="1" @(Model.CerealBarley == 1 ? "checked" : "") />
                            <label class="form-check-label">कोदो</label>
                        </div>
                    </div>
                </div>
                <table class="table table-bordered table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>बाली</th>
                            <th>क्षेत्र (रोपनी)</th>
                            <th>उत्पादन (के.जी.)</th>
                            <th>बिक्री (रु.)</th>
                            <th>घाटा (रु.)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>धान</td>
                            <td><input type="number" step="0.01" name="RiceArea" class="form-control form-control-sm" value="@Model.RiceArea" /></td>
                            <td><input type="number" step="0.01" name="RiceProductionKg" class="form-control form-control-sm" value="@Model.RiceProductionKg" /></td>
                            <td><input type="number" step="0.01" name="RiceSalesRupees" class="form-control form-control-sm" value="@Model.RiceSalesRupees" /></td>
                            <td><input type="number" step="0.01" name="RiceDeficitRupees" class="form-control form-control-sm" value="@Model.RiceDeficitRupees" /></td>
                        </tr>
                        <tr>
                            <td>मकै</td>
                            <td><input type="number" step="0.01" name="MaizeArea" class="form-control form-control-sm" value="@Model.MaizeArea" /></td>
                            <td><input type="number" step="0.01" name="MaizeProductionKg" class="form-control form-control-sm" value="@Model.MaizeProductionKg" /></td>
                            <td><input type="number" step="0.01" name="MaizeSalesRupees" class="form-control form-control-sm" value="@Model.MaizeSalesRupees" /></td>
                            <td><input type="number" step="0.01" name="MaizeDeficitRupees" class="form-control form-control-sm" value="@Model.MaizeDeficitRupees" /></td>
                        </tr>
                        <tr>
                            <td>गहुँ</td>
                            <td><input type="number" step="0.01" name="WheatArea" class="form-control form-control-sm" value="@Model.WheatArea" /></td>
                            <td><input type="number" step="0.01" name="WheatProductionKg" class="form-control form-control-sm" value="@Model.WheatProductionKg" /></td>
                            <td><input type="number" step="0.01" name="WheatSalesRupees" class="form-control form-control-sm" value="@Model.WheatSalesRupees" /></td>
                            <td><input type="number" step="0.01" name="WheatDeficitRupees" class="form-control form-control-sm" value="@Model.WheatDeficitRupees" /></td>
                        </tr>
                        <tr>
                            <td>कोदो</td>
                            <td><input type="number" step="0.01" name="BarleyArea" class="form-control form-control-sm" value="@Model.BarleyArea" /></td>
                            <td><input type="number" step="0.01" name="BarleyProductionKg" class="form-control form-control-sm" value="@Model.BarleyProductionKg" /></td>
                            <td><input type="number" step="0.01" name="BarleySalesRupees" class="form-control form-control-sm" value="@Model.BarleySalesRupees" /></td>
                            <td><input type="number" step="0.01" name="BarleyDeficitRupees" class="form-control form-control-sm" value="@Model.BarleyDeficitRupees" /></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        @* ===== SECTION: PULSES (दलहन) ===== *@
        <div class="card mb-3">
            <div class="card-header" style="background:#8B4513;color:white" data-bs-toggle="collapse" data-bs-target="#secPulses" style="cursor:pointer">
                <h6 class="mb-0"><i class="bi bi-circle-fill"></i> खण्ड ९.२: दलहन</h6>
            </div>
            <div class="card-body collapse show" id="secPulses">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">दलहन खेती गर्नुभएको?</label>
                        <select name="HasPulseCrops" class="form-select">
                            <option value="">-- चयन गर्नुहोस् --</option>
                            <option value="1" selected="@(Model.HasPulseCrops?.ToString() == "1")"> हो </option>
                            <option value="0" selected="@(Model.HasPulseCrops?.ToString() == "0")"> होइन </option>
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">दलहन सारांश</label>
                        <input type="text" name="PulseCropSummary" class="form-control" value="@Model.PulseCropSummary" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">खेती गर्ने दलहन</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="PulseBlackDal" value="1" @(Model.PulseBlackDal == 1 ? "checked" : "") />
                            <label class="form-check-label">भुईंसाउला</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="PulseRahar" value="1" @(Model.PulseRahar == 1 ? "checked" : "") />
                            <label class="form-check-label">रहर</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="PulseMasuro" value="1" @(Model.PulseMasuro == 1 ? "checked" : "") />
                            <label class="form-check-label">मसुरो</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="PulseChana" value="1" @(Model.PulseChana == 1 ? "checked" : "") />
                            <label class="form-check-label">चना</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="PulseSimi" value="1" @(Model.PulseSimi == 1 ? "checked" : "") />
                            <label class="form-check-label">सिमी</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="PulseBhattmas" value="1" @(Model.PulseBhattmas == 1 ? "checked" : "") />
                            <label class="form-check-label">भट्टमास</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="PulseMung" value="1" @(Model.PulseMung == 1 ? "checked" : "") />
                            <label class="form-check-label">मुग</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="PulseKhesari" value="1" @(Model.PulseKhesari == 1 ? "checked" : "") />
                            <label class="form-check-label">खेसारी</label>
                        </div>
                    </div>
                </div>
                <table class="table table-bordered table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>दलहन</th>
                            <th>क्षेत्र (रोपनी)</th>
                            <th>उत्पादन (के.जी.)</th>
                            <th>बिक्री (रु.)</th>
                            <th>घाटा (रु.)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>दलहन १</td>
                            <td><input type="number" step="0.01" name="Pulse1Area" class="form-control form-control-sm" value="@Model.Pulse1Area" /></td>
                            <td><input type="number" step="0.01" name="Pulse1ProductionKg" class="form-control form-control-sm" value="@Model.Pulse1ProductionKg" /></td>
                            <td><input type="number" step="0.01" name="Pulse1SalesRupees" class="form-control form-control-sm" value="@Model.Pulse1SalesRupees" /></td>
                            <td><input type="number" step="0.01" name="Pulse1DeficitRupees" class="form-control form-control-sm" value="@Model.Pulse1DeficitRupees" /></td>
                        </tr>
                        <tr><td>दलहन २</td>
                            <td><input type="number" step="0.01" name="Pulse2Area" class="form-control form-control-sm" value="@Model.Pulse2Area" /></td>
                            <td><input type="number" step="0.01" name="Pulse2ProductionKg" class="form-control form-control-sm" value="@Model.Pulse2ProductionKg" /></td>
                            <td><input type="number" step="0.01" name="Pulse2SalesRupees" class="form-control form-control-sm" value="@Model.Pulse2SalesRupees" /></td>
                            <td><input type="number" step="0.01" name="Pulse2DeficitRupees" class="form-control form-control-sm" value="@Model.Pulse2DeficitRupees" /></td>
                        </tr>
                        <tr><td>दलहन ३</td>
                            <td><input type="number" step="0.01" name="Pulse3Area" class="form-control form-control-sm" value="@Model.Pulse3Area" /></td>
                            <td><input type="number" step="0.01" name="Pulse3ProductionKg" class="form-control form-control-sm" value="@Model.Pulse3ProductionKg" /></td>
                            <td><input type="number" step="0.01" name="Pulse3SalesRupees" class="form-control form-control-sm" value="@Model.Pulse3SalesRupees" /></td>
                            <td><input type="number" step="0.01" name="Pulse3DeficitRupees" class="form-control form-control-sm" value="@Model.Pulse3DeficitRupees" /></td>
                        </tr>
                        <tr><td>दलहन ४</td>
                            <td><input type="number" step="0.01" name="Pulse4Area" class="form-control form-control-sm" value="@Model.Pulse4Area" /></td>
                            <td><input type="number" step="0.01" name="Pulse4ProductionKg" class="form-control form-control-sm" value="@Model.Pulse4ProductionKg" /></td>
                            <td><input type="number" step="0.01" name="Pulse4SalesRupees" class="form-control form-control-sm" value="@Model.Pulse4SalesRupees" /></td>
                            <td><input type="number" step="0.01" name="Pulse4DeficitRupees" class="form-control form-control-sm" value="@Model.Pulse4DeficitRupees" /></td>
                        </tr>
                        <tr><td>दलहन ५</td>
                            <td><input type="number" step="0.01" name="Pulse5Area" class="form-control form-control-sm" value="@Model.Pulse5Area" /></td>
                            <td><input type="number" step="0.01" name="Pulse5ProductionKg" class="form-control form-control-sm" value="@Model.Pulse5ProductionKg" /></td>
                            <td><input type="number" step="0.01" name="Pulse5SalesRupees" class="form-control form-control-sm" value="@Model.Pulse5SalesRupees" /></td>
                            <td><input type="number" step="0.01" name="Pulse5DeficitRupees" class="form-control form-control-sm" value="@Model.Pulse5DeficitRupees" /></td>
                        </tr>
                        <tr><td>दलहन ६</td>
                            <td><input type="number" step="0.01" name="Pulse6Area" class="form-control form-control-sm" value="@Model.Pulse6Area" /></td>
                            <td><input type="number" step="0.01" name="Pulse6ProductionKg" class="form-control form-control-sm" value="@Model.Pulse6ProductionKg" /></td>
                            <td><input type="number" step="0.01" name="Pulse6SalesRupees" class="form-control form-control-sm" value="@Model.Pulse6SalesRupees" /></td>
                            <td><input type="number" step="0.01" name="Pulse6DeficitRupees" class="form-control form-control-sm" value="@Model.Pulse6DeficitRupees" /></td>
                        </tr>
                        <tr><td>दलहन ७</td>
                            <td><input type="number" step="0.01" name="Pulse7Area" class="form-control form-control-sm" value="@Model.Pulse7Area" /></td>
                            <td><input type="number" step="0.01" name="Pulse7ProductionKg" class="form-control form-control-sm" value="@Model.Pulse7ProductionKg" /></td>
                            <td><input type="number" step="0.01" name="Pulse7SalesRupees" class="form-control form-control-sm" value="@Model.Pulse7SalesRupees" /></td>
                            <td><input type="number" step="0.01" name="Pulse7DeficitRupees" class="form-control form-control-sm" value="@Model.Pulse7DeficitRupees" /></td>
                        </tr>
                        <tr><td>दलहन ८</td>
                            <td><input type="number" step="0.01" name="Pulse8Area" class="form-control form-control-sm" value="@Model.Pulse8Area" /></td>
                            <td><input type="number" step="0.01" name="Pulse8ProductionKg" class="form-control form-control-sm" value="@Model.Pulse8ProductionKg" /></td>
                            <td><input type="number" step="0.01" name="Pulse8SalesRupees" class="form-control form-control-sm" value="@Model.Pulse8SalesRupees" /></td>
                            <td><input type="number" step="0.01" name="Pulse8DeficitRupees" class="form-control form-control-sm" value="@Model.Pulse8DeficitRupees" /></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        @* ===== SECTION: OILSEEDS (तेलहन) ===== *@
        <div class="card mb-3">
            <div class="card-header" style="background:#DAA520;color:black" data-bs-toggle="collapse" data-bs-target="#secOilseeds" style="cursor:pointer">
                <h6 class="mb-0"><i class="bi bi-droplet"></i> खण्ड ९.३: तेलहन</h6>
            </div>
            <div class="card-body collapse show" id="secOilseeds">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">तेलहन खेती गर्नुभएको?</label>
                        <select name="HasOilseedCrops" class="form-select">
                            <option value="">-- चयन गर्नुहोस् --</option>
                            <option value="1" selected="@(Model.HasOilseedCrops?.ToString() == "1")"> हो </option>
                            <option value="0" selected="@(Model.HasOilseedCrops?.ToString() == "0")"> होइन </option>
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">तेलहन सारांश</label>
                        <input type="text" name="OilseedCropSummary" class="form-control" value="@Model.OilseedCropSummary" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-12">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="OilseedTori" value="1" @(Model.OilseedTori == 1 ? "checked" : "") />
                            <label class="form-check-label">तोरी</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="OilseedTil" value="1" @(Model.OilseedTil == 1 ? "checked" : "") />
                            <label class="form-check-label">तिल</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="OilseedSunflower" value="1" @(Model.OilseedSunflower == 1 ? "checked" : "") />
                            <label class="form-check-label">सूर्यमुखी</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="OilseedOther" value="1" @(Model.OilseedOther == 1 ? "checked" : "") />
                            <label class="form-check-label">अन्य</label>
                        </div>
                    </div>
                </div>
