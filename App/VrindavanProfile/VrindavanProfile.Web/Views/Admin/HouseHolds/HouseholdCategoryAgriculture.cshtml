                        <label class="form-label">ऋण छ?</label>
                        <select name="HasLoan" class="form-select">
                            <option value="">-- चयन गर्नुहोस् --</option>
                            <option value="1" selected="@(Model.HasLoan?.ToString() == "1")"> हो </option>
                            <option value="0" selected="@(Model.HasLoan?.ToString() == "0")"> होइन </option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">ऋण रकम</label>
                        <input type="text" name="LoanAmount" class="form-control" value="@Model.LoanAmount" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">ऋण प्रकार</label>
                        <input type="text" name="LoanType" class="form-control" value="@Model.LoanType" />
                    </div>
                    <div class="col-md-8 mb-3">
                        <label class="form-label">ऋण स्रोत सारांश</label>
                        <input type="text" name="LoanSourceSummary" class="form-control" value="@Model.LoanSourceSummary" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">ऋण स्रोत</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="LoanFromBank" value="1" @(Model.LoanFromBank == 1 ? "checked" : "") />
                            <label class="form-check-label">बैंक</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="LoanFromCoop" value="1" @(Model.LoanFromCoop == 1 ? "checked" : "") />
                            <label class="form-check-label">सहकारी</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="LoanFromMoneylender" value="1" @(Model.LoanFromMoneylender == 1 ? "checked" : "") />
                            <label class="form-check-label">महाजन</label>
                        </div>
