                        <input type="number" step="0.01" name="IncomeVegetables" class="form-control" value="@Model.IncomeVegetables" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">ज्याला बाट (रु.)</label>
                        <input type="number" step="0.01" name="IncomeLabor" class="form-control" value="@Model.IncomeLabor" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">व्यापार बाट (रु.)</label>
                        <input type="number" step="0.01" name="IncomeTrade" class="form-control" value="@Model.IncomeTrade" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">विदेश बाट (रु.)</label>
                        <input type="number" step="0.01" name="IncomeForeign" class="form-control" value="@Model.IncomeForeign" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">नोकरी बाट (रु.)</label>
                        <input type="number" step="0.01" name="IncomeJob" class="form-control" value="@Model.IncomeJob" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">अन्य बाट (रु.)</label>
                        <input type="number" step="0.01" name="IncomeOther" class="form-control" value="@Model.IncomeOther" />
                    </div>
                </div>
            </div>
        </div>

        @* ===== SECTION: EXPENDITURE (खर्च) ===== *@
        <div class="card mb-3">
            <div class="card-header bg-dark text-white" data-bs-toggle="collapse" data-bs-target="#secExpenditure" style="cursor:pointer">
                <h6 class="mb-0"><i class="bi bi-receipt"></i> खण्ड १५: खर्च</h6>
            </div>
            <div class="card-body collapse show" id="secExpenditure">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">खाद्य (रु.)</label>
                        <input type="number" step="0.01" name="ExpenseFood" class="form-control" value="@Model.ExpenseFood" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">लुगा (रु.)</label>
                        <input type="number" step="0.01" name="ExpenseClothes" class="form-control" value="@Model.ExpenseClothes" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">शिक्षा (रु.)</label>
                        <input type="number" step="0.01" name="ExpenseEducation" class="form-control" value="@Model.ExpenseEducation" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">स्वास्थ्य (रु.)</label>
                        <input type="number" step="0.01" name="ExpenseHealth" class="form-control" value="@Model.ExpenseHealth" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">चाडपर्व (रु.)</label>
                        <input type="number" step="0.01" name="ExpenseFestivals" class="form-control" value="@Model.ExpenseFestivals" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">कृषि (रु.)</label>
                        <input type="number" step="0.01" name="ExpenseAgriculture" class="form-control" value="@Model.ExpenseAgriculture" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">इन्धन (रु.)</label>
                        <input type="number" step="0.01" name="ExpenseFuel" class="form-control" value="@Model.ExpenseFuel" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">मोबाइल/इन्टरनेट (रु.)</label>
                        <input type="number" step="0.01" name="ExpenseMobileInternet" class="form-control" value="@Model.ExpenseMobileInternet" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">खाद्य पर्याप्तता (महिना)</label>
                        <input type="text" name="FoodSufficiencyMonths" class="form-control" value="@Model.FoodSufficiencyMonths" />
                    </div>
                </div>
                @* Deficit spending *@
                <div class="row mt-3">
                    <div class="col-md-8 mb-3">
                        <label class="form-label">घाटा खर्च सारांश</label>
                        <input type="text" name="DeficitSpendingSummary" class="form-control" value="@Model.DeficitSpendingSummary" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">घाटा खर्चका स्रोत</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="DeficitJob" value="1" @(Model.DeficitJob == 1 ? "checked" : "") />
                            <label class="form-check-label">नोकरी</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="DeficitDailyWage" value="1" @(Model.DeficitDailyWage == 1 ? "checked" : "") />
                            <label class="form-check-label">दैनिक ज्याला</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="DeficitForeignJob" value="1" @(Model.DeficitForeignJob == 1 ? "checked" : "") />
                            <label class="form-check-label">विदेशी रोजगार</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="DeficitTrade" value="1" @(Model.DeficitTrade == 1 ? "checked" : "") />
                            <label class="form-check-label">व्यापार</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="DeficitLoan" value="1" @(Model.DeficitLoan == 1 ? "checked" : "") />
                            <label class="form-check-label">ऋण</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ===== SECTION: BANKING (बैंक तथा ऋण) ===== *@
