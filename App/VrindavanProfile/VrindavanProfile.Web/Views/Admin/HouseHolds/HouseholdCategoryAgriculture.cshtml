                            <input class="form-check-input" type="checkbox" name="LoanFromRelatives" value="1" @(Model.LoanFromRelatives == 1 ? "checked" : "") />
                            <label class="form-check-label">आफन्त</label>
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-8 mb-3">
                        <label class="form-label">ऋण उद्देश्य सारांश</label>
                        <input type="text" name="LoanPurposeSummary" class="form-control" value="@Model.LoanPurposeSummary" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">अन्य विवरण</label>
                        <input type="text" name="LoanPurposeOtherDetail" class="form-control" value="@Model.LoanPurposeOtherDetail" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">ऋण उद्देश्य</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="LoanPurposeBusiness" value="1" @(Model.LoanPurposeBusiness == 1 ? "checked" : "") />
                            <label class="form-check-label">व्यापार</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="LoanPurposeHouse" value="1" @(Model.LoanPurposeHouse == 1 ? "checked" : "") />
                            <label class="form-check-label">घर</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="LoanPurposeMedical" value="1" @(Model.LoanPurposeMedical == 1 ? "checked" : "") />
                            <label class="form-check-label">स्वास्थ्य</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="LoanPurposeEducation" value="1" @(Model.LoanPurposeEducation == 1 ? "checked" : "") />
                            <label class="form-check-label">शिक्षा</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="LoanPurposeOther" value="1" @(Model.LoanPurposeOther == 1 ? "checked" : "") />
                            <label class="form-check-label">अन्य</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ===== SAVE BUTTON ===== *@
        <div class="row mt-3 mb-5">
            <div class="col-12">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-save"></i> डाटा सुरक्षित गर्नुहोस्
                </button>
                <a href="/Admin/ManageHouseholdData/@householdId" class="btn btn-secondary btn-lg ms-2">
                    <i class="bi bi-arrow-left"></i> फर्कनुहोस्
                </a>
            </div>
        </div>
    </form>
</div>