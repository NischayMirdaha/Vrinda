                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">वार्षिक आम्दानी (रु.)</label>
                        <input type="number" step="0.01" name="FishAnnualIncome" class="form-control" value="@Model.FishAnnualIncome" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">अनुदान</label>
                        <input type="text" name="FishSubsidy" class="form-control" value="@Model.FishSubsidy" />
                    </div>
                </div>
            </div>
        </div>

        @* ===== SECTION: BEEKEEPING (मौरीपालन) ===== *@
        <div class="card mb-3">
            <div class="card-header" style="background:#F4A460;color:black" data-bs-toggle="collapse" data-bs-target="#secBee" style="cursor:pointer">
                <h6 class="mb-0"><i class="bi bi-hexagon"></i> खण्ड १३: मौरीपालन</h6>
            </div>
            <div class="card-body collapse show" id="secBee">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">मौरीपालन गर्नुभएको?</label>
