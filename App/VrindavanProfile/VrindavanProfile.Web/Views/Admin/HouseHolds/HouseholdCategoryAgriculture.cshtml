                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="MeatCalf" value="1" @(Model.MeatCalf == 1 ? "checked" : "") />
                            <label class="form-check-label">पाडा</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="MeatPig" value="1" @(Model.MeatPig == 1 ? "checked" : "") />
                            <label class="form-check-label">सुँगुर</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="MeatOther" value="1" @(Model.MeatOther == 1 ? "checked" : "") />
