                <div class="row mb-3">
                    <div class="col-md-8">
                        <label class="form-label">पोल्ट्री सारांश</label>
                        <input type="text" name="PoultrySummary" class="form-control" value="@Model.PoultrySummary" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-12">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="PoultryChicken" value="1" @(Model.PoultryChicken == 1 ? "checked" : "") />
                            <label class="form-check-label">कुखुरा</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="PoultryDuck" value="1" @(Model.PoultryDuck == 1 ? "checked" : "") />
