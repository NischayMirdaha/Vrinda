                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="PoultryBattai" value="1" @(Model.PoultryBattai == 1 ? "checked" : "") />
                            <label class="form-check-label">बटाई</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <label class="form-label">पोल्ट्री संख्या</label>
                        <input type="number" name="PoultryCount" class="form-control" value="@Model.PoultryCount" />
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="form-label">वार्षिक अण्डा</label>
                        <input type="number" name="PoultryEggAnnual" class="form-control" value="@Model.PoultryEggAnnual" />
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="form-label">मासु बिक्री (के.जी.)</label>
                        <input type="number" step="0.01" name="PoultryMeatSoldKg" class="form-control" value="@Model.PoultryMeatSoldKg" />
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="form-label">वार्षिक आम्दानी (रु.)</label>
                        <input type="number" step="0.01" name="PoultryAnnualIncome" class="form-control" value="@Model.PoultryAnnualIncome" />
                    </div>
                </div>
            </div>
        </div>

        @* ===== SECTION: FISH (माछापालन) ===== *@
        <div class="card mb-3">
            <div class="card-header" style="background:#4682B4;color:white" data-bs-toggle="collapse" data-bs-target="#secFish" style="cursor:pointer">
                <h6 class="mb-0"><i class="bi bi-water"></i> खण्ड १२: माछापालन</h6>
            </div>
            <div class="card-body collapse show" id="secFish">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">माछापालन गर्नुभएको?</label>
                        <select name="HasFishFarming" class="form-select">
                            <option value="">-- चयन गर्नुहोस् --</option>
                            <option value="1" selected="@(Model.HasFishFarming?.ToString() == "1")"> हो </option>
                            <option value="0" selected="@(Model.HasFishFarming?.ToString() == "0")"> होइन </option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">पोखरी संख्या</label>
                        <input type="number" name="FishPondCount" class="form-control" value="@Model.FishPondCount" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">क्षेत्रफल (रोपनी)</label>
