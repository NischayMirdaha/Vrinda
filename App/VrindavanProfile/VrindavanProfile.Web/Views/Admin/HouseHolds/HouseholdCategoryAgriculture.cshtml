                            <td><input type="number" name="GoatCount" class="form-control form-control-sm" value="@Model.GoatCount" /></td>
                            <td><input type="number" step="0.01" name="GoatAnnualSold" class="form-control form-control-sm" value="@Model.GoatAnnualSold" /></td>
                            <td><input type="number" step="0.01" name="GoatAnnualIncome" class="form-control form-control-sm" value="@Model.GoatAnnualIncome" /></td>
                        </tr>
                        <tr><td>पाडा</td>
                            <td><input type="number" name="CalfCount" class="form-control form-control-sm" value="@Model.CalfCount" /></td>
                            <td><input type="number" step="0.01" name="CalfAnnualSold" class="form-control form-control-sm" value="@Model.CalfAnnualSold" /></td>
                            <td><input type="number" step="0.01" name="CalfAnnualIncome" class="form-control form-control-sm" value="@Model.CalfAnnualIncome" /></td>
                        </tr>
                        <tr><td>सुँगुर</td>
                            <td><input type="number" name="PigCount" class="form-control form-control-sm" value="@Model.PigCount" /></td>
                            <td><input type="number" step="0.01" name="PigAnnualSold" class="form-control form-control-sm" value="@Model.PigAnnualSold" /></td>
                            <td><input type="number" step="0.01" name="PigAnnualIncome" class="form-control form-control-sm" value="@Model.PigAnnualIncome" /></td>
                        </tr>
                        <tr><td>अन्य</td>
                            <td><input type="number" name="OtherMeatCount" class="form-control form-control-sm" value="@Model.OtherMeatCount" /></td>
                            <td><input type="number" step="0.01" name="OtherMeatAnnualSold" class="form-control form-control-sm" value="@Model.OtherMeatAnnualSold" /></td>
                            <td><input type="number" step="0.01" name="OtherMeatAnnualIncome" class="form-control form-control-sm" value="@Model.OtherMeatAnnualIncome" /></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        @* ===== SECTION: POULTRY (पोल्ट्री) ===== *@
