const BS_END_YEAR = BS_START_YEAR + BS_YEAR_DATA.length - 1; // 2095

const BS_MONTHS_NP = ['बैशाख','जेठ','असार','साउन','भदौ','असोज','कार्तिक','मंसिर','पुस','माघ','फागुन','चैत'];

// Today in BS (from server)
const TODAY_BS = { y: @todayBsY, m: @todayBsM, d: @todayBsD };

function daysInBsMonth(year, month) {
    const idx = year - BS_START_YEAR;
    if (idx < 0 || idx >= BS_YEAR_DATA.length || month < 1 || month > 12) return 30;
    return BS_YEAR_DATA[idx][month - 1];
}

function calcAgeBs(y, m, d) {
    let age = TODAY_BS.y - y;
    if (TODAY_BS.m < m || (TODAY_BS.m === m && TODAY_BS.d < d)) age--;
    return age < 0 ? 0 : age;
}

function pad2(n) { return String(n).padStart(2,'0'); }

function buildYearOptions(selId, selectedYear) {
    const sel = document.getElementById(selId);
    sel.innerHTML = '<option value="">— साल —</option>';
    for (let y = TODAY_BS.y; y >= BS_START_YEAR; y--) {
        const opt = document.createElement('option');
        opt.value = y;
        opt.textContent = y;
        if (y === selectedYear) opt.selected = true;
        sel.appendChild(opt);
    }
}

function buildMonthOptions(selId, selectedMonth) {
    const sel = document.getElementById(selId);
    sel.innerHTML = '<option value="">— महिना —</option>';
    BS_MONTHS_NP.forEach((name, i) => {
        const opt = document.createElement('option');
        opt.value = i + 1;
        opt.textContent = `${i+1}. ${name}`;
        if ((i + 1) === selectedMonth) opt.selected = true;
        sel.appendChild(opt);
    });
}

function buildDayOptions(selId, year, month, selectedDay) {
    const sel = document.getElementById(selId);
    const maxDay = year ? daysInBsMonth(parseInt(year), parseInt(month || 1)) : 32;
    const currentVal = selectedDay || parseInt(sel.value) || 1;
    sel.innerHTML = '<option value="">— गते —</option>';
    for (let d = 1; d <= maxDay; d++) {
        const opt = document.createElement('option');
        opt.value = d;
        opt.textContent = d;
        if (d === currentVal) opt.selected = true;
        sel.appendChild(opt);
    }
}

// ── Initialise ADD form pickers ───────────────────────────
function initAddPicker() {
    buildYearOptions('addYear', null);
    buildMonthOptions('addMonth', null);
    buildDayOptions('addDay', null, null, null);

    ['addYear','addMonth','addDay'].forEach(id => {
        document.getElementById(id).addEventListener('change', syncAddDob);
    });

    // Also watch manual age input → derive DOB
    document.getElementById('addAgeInput').addEventListener('input', function() {
        const age = parseInt(this.value);
        if (!isNaN(age) && age >= 0) {
            const birthY = TODAY_BS.y - age;
            setPickerValues('add', birthY, TODAY_BS.m, TODAY_BS.d);
            syncAddDob();
        }
    });
}

function setPickerValues(prefix, y, m, d) {
    const ySel = document.getElementById(prefix + 'Year');
    const mSel = document.getElementById(prefix + 'Month');
    const dSel = document.getElementById(prefix + 'Day');
    // Rebuild to match selections
    buildYearOptions(prefix + 'Year', y);
    buildMonthOptions(prefix + 'Month', m);
    buildDayOptions(prefix + 'Day', y, m, d);
}

function syncAddDob() {
    const y = parseInt(document.getElementById('addYear').value);
    const m = parseInt(document.getElementById('addMonth').value);
    const d = parseInt(document.getElementById('addDay').value);
    const dobInput = document.getElementById('addDobBs');
    const badge   = document.getElementById('addAgeBadge');
    const ageIn   = document.getElementById('addAgeInput');

    if (y && m && d) {
        // Rebuild day options if year/month changed
        buildDayOptions('addDay', y, m, d);
        const dob = `${y}-${pad2(m)}-${pad2(d)}`;
        dobInput.value = dob;
        const age = calcAgeBs(y, m, d);
        badge.textContent = age + ' वर्ष';
        badge.classList.remove('no-dob');
        ageIn.value = age;
    } else {
        dobInput.value = '';
        badge.textContent = '—';
        badge.classList.add('no-dob');
    }
}

// ── Initialise EDIT modal pickers ───────────────────────────
function initEditPicker(y, m, d) {
    buildYearOptions('editYear', y);
    buildMonthOptions('editMonth', m);
    buildDayOptions('editDay', y, m, d);

    ['editYear','editMonth','editDay'].forEach(id => {
        document.getElementById(id).addEventListener('change', syncEditDob);
    });

    document.getElementById('editAgeInput').addEventListener('input', function() {
        const age = parseInt(this.value);
        if (!isNaN(age) && age >= 0) {
            const birthY = TODAY_BS.y - age;
            setPickerValues('edit', birthY, TODAY_BS.m, TODAY_BS.d);
            syncEditDob();
        }
    });
    syncEditDob();
}

function syncEditDob() {
    const y = parseInt(document.getElementById('editYear').value);
    const m = parseInt(document.getElementById('editMonth').value);
    const d = parseInt(document.getElementById('editDay').value);
    const dobInput = document.getElementById('editDobBs');
    const badge   = document.getElementById('editAgeBadge');
    const ageIn   = document.getElementById('editAgeInput');

    if (y && m && d) {
        buildDayOptions('editDay', y, m, d);
        const dob = `${y}-${pad2(m)}-${pad2(d)}`;
        dobInput.value = dob;
        const age = calcAgeBs(y, m, d);
        badge.textContent = age + ' वर्ष';
        badge.classList.remove('no-dob');
        ageIn.value = age;
    } else {
        dobInput.value = '';
        badge.textContent = '—';
        badge.classList.add('no-dob');
    }
}

// ── Modal opener ────────────────────────────────────────────
function openEditFamilyModal(id, fullName, surname, gender, age, relation, dobBs) {
    document.getElementById('editFmId').value       = id;
    document.getElementById('editFmFullName').value  = fullName;
    document.getElementById('editFmSurname').value   = surname;
    document.getElementById('editFmGender').value    = gender;
    document.getElementById('editFmRelation').value  = relation;

    // Remove old change listeners by cloning the selects
    ['editYear','editMonth','editDay'].forEach(selId => {
        const el = document.getElementById(selId);
        const clone = el.cloneNode(false);
        el.parentNode.replaceChild(clone, el);
    });
    document.getElementById('editAgeInput').value = age || '';

    let bsY = null, bsM = null, bsD = null;
    if (dobBs && dobBs.match(/^\d{4}-\d{2}-\d{2}$/)) {
        const parts = dobBs.split('-');
        bsY = parseInt(parts[0]);
        bsM = parseInt(parts[1]);
        bsD = parseInt(parts[2]);
    } else if (age && parseInt(age) > 0) {
        bsY = TODAY_BS.y - parseInt(age);
        bsM = TODAY_BS.m;
        bsD = TODAY_BS.d;
    }

    initEditPicker(bsY, bsM, bsD);
    new bootstrap.Modal(document.getElementById('editFamilyModal')).show();
}

function openEditHouseModal(id, ownership, rooms, roof) {
    document.getElementById('editHdId').value        = id;
    document.getElementById('editHdOwnership').value  = ownership;
    document.getElementById('editHdRooms').value      = rooms;
    document.getElementById('editHdRoof').value       = roof;
    new bootstrap.Modal(document.getElementById('editHouseModal')).show();
}

function openEditDeathModal(id, name, gender, age, cause) {
    document.getElementById('editDrId').value    = id;
    document.getElementById('editDrName').value  = name;
    document.getElementById('editDrGender').value = gender;
    document.getElementById('editDrAge').value   = age;
    document.getElementById('editDrCause').value = cause;
    new bootstrap.Modal(document.getElementById('editDeathModal')).show();
}

