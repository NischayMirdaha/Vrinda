<div class="container py-4">
<div class="d-flex justify-content-between align-items-center mb-3">
<h3 class="fw-bold mb-0">@ViewData["Title"]</h3>
<a href="/Admin/Institutions?subjectArea=@Model.SubjectArea" class="btn
btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left"></i> सूचीमा फर्कनुहोस्
</a>
</div>
<form action="/Admin/@(isEdit ? $"EditInstitution/{Model.Id}" : "CreateInstitution")?subjectArea=@Model.SubjectArea" method="post">
@Html.AntiForgeryToken()
<input type="hidden" name="subjectArea" value="@Model.SubjectArea" />
<input type="hidden" name="id" value="@Model.Id" />
<!-- Card 1: Survey Entry Info -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-header bg-primary text-white py-3">
        <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>आधारभूत
            सर्वेक्षण प्रविष्टि विवरण</h6>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label fw-bold">वडा नं. <span
                                                              class="text-danger">*</span></label>
                <input name="SurveyEntry.WardNo" type="number"
                       class="form-control" value="@Model.SurveyEntry.WardNo" required />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label fw-bold">तथ्याङ्क प्रविष्टिकर्ता</label>
                <input name="SurveyEntry.EnumeratorName" class="formcontrol" value="@Model.SurveyEntry.EnumeratorName" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label fw-bold">सम्पर्क फोन नम्बर</label>
                <input name="SurveyEntry.PhoneNumber" class="formcontrol" value="@Model.SurveyEntry.PhoneNumber" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label fw-bold">उपकरण पहिचान (Device ID)</label>
                <input name="SurveyEntry.DeviceId" class="form-control"
                       value="@Model.SurveyEntry.DeviceId" />
            </div>
        </div>
    </div>
</div>
<!-- Card 2: Dynamically Rendered Entity Properties -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-dark text-white py-3">
        <h6 class="mb-0"><i class="bi bi-input-cursor-text
me-2"></i>@Model.DisplayName - विवरण फारम</h6>
    </div>
    <div class="card-body">
        <div class="row">
            @{
                var properties = Model.ChildEntity.GetType().GetProperties()
                    .Where(p => p.Name != "Id" && p.Name !=
                        "SurveyEntryId" && p.Name != "SurveyEntry")
                    .OrderBy(p => p.Name);
                foreach (var prop in properties)
                {
                    var propValue = prop.GetValue(Model.ChildEntity);
                    string labelName =
                        labelsNep.ContainsKey(prop.Name) ? labelsNep[prop.Name] :
                            System.Text.RegularExpressions.Regex.Replace(prop.Name, "(\\B[A-Z])", " $1");

                    var t =
                        Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
                    <div class="col-md-4 mb-3">
                        <label class="form-label small fw-semibold textsecondary">@labelName</label>

                        @if (t == typeof(double) || t == typeof(int) ||
                             t == typeof(short) || t == typeof(long))
                        {
                            <input name="ChildEntity.@prop.Name"
                                   type="number" step="any" class="form-control" value="@propValue" />
                        }
                        else if (t == typeof(bool))
                        {
                            <select name="ChildEntity.@prop.Name"
                                    class="form-select">
                                <option value="">— चयन गर्नुहोस् —</option>
                                <option value="true"
                                        selected="@(propValue?.ToString() == "True")">हो</option>
                                <option value="false"
                                        selected="@(propValue?.ToString() == "False")">होइन</option>
                            </select>
                        }
                        else
                        {
                            // Dropdowns for yes/no or selection is applicable, else text input
                            if (prop.Name.StartsWith("Has") ||
                                prop.Name.EndsWith("Available") || prop.Name.EndsWith("Status"))
                            {
                                <select name="ChildEntity.@prop.Name"
                                        class="form-select">
                                    <option value="">— चयन गर्नुहोस् —</option>
                                    <option value="Yes"
                                            selected="@(propValue?.ToString() == "Yes")">हो</option>
                                    <option value="No"
                                            selected="@(propValue?.ToString() == "No")">होइन</option>
                                    <option value="Pending"
                                            selected="@(propValue?.ToString() == "Pending")">विचाराधीन</option>
                                </select>
                            }
                            else if (prop.Name == "Photo" || prop.Name
                                     == "InstitutionDetail" || prop.Name == "Notes" || prop.Name == "Description")
                            {
                                <textarea name="ChildEntity.@prop.Name" class="form-control" rows="2">@propValue</textarea>
                            }
                            else
                            {
                                <input name="ChildEntity.@prop.Name" class="form-control" value="@propValue" />

                            }
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label fw-bold">कैफियत / टिप्पणीहरू</label>
            <textarea name="SurveyEntry.Notes" class="form-control"
rows="2">@Model.SurveyEntry.Notes</textarea>
        </div>
    </div>
</div>
<!-- Action Panel -->
<div class="mb-5 d-flex gap-2">
    <button type="submit" class="btn btn-primary px-4 py-2"><i class="bi
bi-save me-1"></i>डाटा सेभ गर्नुहोस्</button>
    <a href="/Admin/Institutions?subjectArea=@Model.SubjectArea"
       class="btn btn-outline-secondary px-4 py-2">रद्द गर्नुहोस्</a>
</div>
</form>
</div>
