@{
    // Clean layout for print/PDF views — no navbar, no footer
    // Used by Print.cshtml and full-page export views
}
<!DOCTYPE html>
<html lang="ne">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — वृन्दावन नगरपालिका</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/themes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" media="print" />
    <style>
        /* Inline clean-layout styles — lightweight, no external deps */
        :root {
            --primary: #2D6A4F;
            --primary-light: #40916C;
            --primary-dark: #1B4332;
            --accent: #D4A373;
            --background: #FEFAE0;
            --surface: #FFFFFF;
            --text-dark: #1B1B1B;
            --text-muted: #6C757D;
        }

        body {
            font-family: 'Mukta', 'Noto Sans Devanagari', 'Segoe UI', sans-serif;
            color: var(--text-dark);
            line-height: 1.6;
            background: #fff;
            font-size: 11px;
            margin: 0;
            padding: 0;
        }

        /* ─── Print Header ─── */
        .print-page-header {
            text-align: center;
            padding: 12px 0;
            border-bottom: 3px double var(--primary);
            margin-bottom: 16px;
        }

        .print-page-header .muni-name {
            font-size: 18px;
            font-weight: 800;
            color: var(--primary);
            margin: 0;
            letter-spacing: 0.5px;
        }

        .print-page-header .muni-detail {
            font-size: 10px;
            color: var(--text-muted);
            margin: 2px 0 0;
        }

        .print-page-header .muni-logo-icon {
            font-size: 2rem;
            color: var(--primary);
            opacity: 0.15;
            position: absolute;
            left: 20px;
            top: 12px;
        }

        .print-page-header .system-badge {
            display: inline-block;
            background: var(--primary);
            color: #fff;
            padding: 2px 10px;
            border-radius: 10px;
            font-size: 8px;
            font-weight: 600;
            margin-top: 4px;
        }

        /* ─── Print Title ─── */
        .print-title-bar {
            text-align: center;
            margin-bottom: 16px;
        }

        .print-title-bar h5 {
            font-weight: 700;
            color: var(--primary);
            margin: 0;
            font-size: 14px;
        }

        .print-title-bar .print-subtitle {
            font-size: 10px;
            color: var(--text-muted);
        }

        /* ─── Print Footer / Watermark ─── */
        .print-page-footer {
            text-align: center;
            border-top: 1px solid #ddd;
            padding: 6px 0;
            margin-top: 20px;
            font-size: 8px;
            color: #999;
        }

        /* ─── Table styling for clean layout ─── */
        .table {
            font-size: 10px;
            margin-bottom: 0;
        }

        .table thead th {
            background-color: var(--primary) !important;
            color: #fff !important;
            font-size: 9px;
            font-weight: 600;
            padding: 5px 8px;
            text-align: center;
            white-space: nowrap;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .table tbody td {
            padding: 4px 8px;
            font-size: 10px;
            border: 1px solid #dee2e6;
        }

        .table tfoot td {
            background-color: var(--accent) !important;
            font-weight: 700;
            font-size: 10px;
            padding: 5px 8px;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        /* ─── Action bar (screen only, hidden on print) ─── */
        .print-actions {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 10px 16px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .print-actions .btn {
            font-size: 0.82rem;
        }

        /* ─── Print media overrides ─── */
        @@media print {
            .print-actions {
                display: none !important;
            }

            body {
                padding: 0;
                margin: 0;
            }

            .print-page-header {
                border-bottom-width: 2px;
            }
        }

        /* ─── Screen media: slight off-white bg for readability ─── */
        @@media screen {
            body {
                background: #f5f5f0;
                padding: 16px;
            }

            .print-page-wrapper {
                max-width: 210mm;
                margin: 0 auto;
                background: #fff;
                box-shadow: 0 2px 16px rgba(0,0,0,0.1);
                padding: 20px 24px;
                border-radius: 4px;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="print-page-wrapper">
        <!-- Standardized Print Header -->
        <header class="print-page-header position-relative">
            <i class="bi bi-building muni-logo-icon"></i>
            <h4 class="muni-name">वृन्दावन नगरपालिका</h4>
            <p class="muni-detail">रुपन्देही जिल्ला, लुम्बिनी प्रदेश, नेपाल</p>
            <span class="system-badge"><i class="bi bi-bar-chart me-1"></i>डिजिटल प्रोफाइल प्रणाली</span>
        </header>

        <!-- Action Buttons (screen only) -->
        @await RenderSectionAsync("PrintActions", required: false)

        <!-- Main Content -->
        <main>
            @RenderBody()
        </main>

        <!-- Standardized Footer -->
        <footer class="print-page-footer">
            प्रिन्ट मिति: @DateTime.Now.ToString("yyyy/MM/dd HH:mm")
            &nbsp;|&nbsp;
            वृन्दावन नगरपालिका डिजिटल प्रोफाइल प्रणाली
            &nbsp;|&nbsp;
            सर्वाधिकार सुरक्षित © @DateTime.Now.Year
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
