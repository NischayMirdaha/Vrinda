@model Load.Models.ImportResult
@{ ViewData["Title"] = "Import Results"; }

<div class="container mt-4">
    <h1>@(Model.ErrorCount == 0 && Model.SkippedCount == 0 ? "✅" : "⚠️") @Model.ImportType Import Complete</h1>

    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card text-center bg-primary text-white">
                <div class="card-body"><h3>@Model.TotalRows.ToString("N0")</h3><small>Total</small></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center bg-success text-white">
                <div class="card-body"><h3>@Model.SuccessCount.ToString("N0")</h3><small>Imported</small></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center bg-danger text-white">
                <div class="card-body"><h3>@Model.ErrorCount</h3><small>Errors</small></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center bg-warning text-dark">
                <div class="card-body"><h3>@Model.SkippedCount</h3><small>Skipped</small></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center bg-secondary text-white">
                <div class="card-body"><h3>@Model.FilesProcessed</h3><small>Files</small></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center bg-info text-white">
                <div class="card-body"><h3>@Model.Duration.TotalSeconds.ToString("F1")s</h3><small>Duration</small></div>
            </div>
        </div>
    </div>

    @if (Model.SubjectAreaCounts.Any())
    {
        <div class="card mb-3">
            <div class="card-header"><strong>📊 Records by Type</strong></div>
            <div class="card-body">
                <table class="table table-sm table-bordered">
                    <thead class="table-dark"><tr><th>Type</th><th>Count</th></tr></thead>
                    <tbody>
                        @foreach (var kvp in Model.SubjectAreaCounts.OrderByDescending(k => k.Value))
                        { <tr><td>@kvp.Key</td><td><strong>@kvp.Value</strong></td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    }

        @if (Model.TableRowCounts.Any())
    {
        <div class="card mb-3">
            <div class="card-header"><strong>📊 Total Rows in Database</strong></div>
            <div class="card-body">
                <div class="row">
                    @foreach (var kvp in Model.TableRowCounts.OrderByDescending(k => k.Value))
                    {
                        <div class="col-md-3 mb-2">
                            <div class="card border">
                                <div class="card-body p-2 text-center">
                                    <h5 class="mb-0">@kvp.Value.ToString("N0")</h5>
                                    <small class="text-muted">@kvp.Key</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <hr/>
                <strong>Grand Total: @Model.TableRowCounts.Values.Sum().ToString("N0") rows across @Model.TableRowCounts.Count tables</strong>
            </div>
        </div>
    }

    @if (Model.UnmappedKeys.Any())
    {
        <div class="card border-warning mb-3">
            <div class="card-header bg-warning text-dark">
                <strong>⚠️ Unmapped Keys (@Model.UnmappedKeys.Count)</strong>
            </div>
            <div class="card-body" style="max-height:400px; overflow-y:auto;">
<pre style="font-size:12px;">@foreach (var k in Model.UnmappedKeys)
{<text>["@k"] = new() { Table = "???", Column = "???", Type = ColType.Text },
</text>}</pre>
            </div>
        </div>
    }

    @if (Model.Errors.Any())
    {
        <div class="card border-danger mb-3">
            <div class="card-header bg-danger text-white">Errors (first 100)</div>
            <div class="card-body" style="max-height:300px; overflow-y:auto;">
                <ul>@foreach (var e in Model.Errors) { <li><small>@e</small></li> }</ul>
            </div>
        </div>
    }

    @if (Model.Warnings.Any())
    {
        <div class="card border-info mb-3">
            <div class="card-header">Warnings</div>
            <div class="card-body" style="max-height:200px; overflow-y:auto;">
                <ul>@foreach (var w in Model.Warnings) { <li><small>@w</small></li> }</ul>
            </div>
        </div>
    }

    <a href="javascript:history.back()" class="btn btn-primary">← Back</a>
    <a href="/" class="btn btn-outline-secondary">Home</a>
</div>